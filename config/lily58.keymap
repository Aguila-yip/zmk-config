#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        PAT_Tap_Hold: PAT_Tap_Hold {
            compatible = "zmk,behavior-hold-tap";
            label = "PAT_TAP_HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC                 &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&PAT_Tap_Hold CAPS TAB  &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp NON_US_BACKSLASH
&kp LCTRL               &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT               &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                        &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp SPACE  &mo 2   &none   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Left_T.Layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Sys. & numKey";
            bindings = <
&none   &bt BT_SEL 0  &bt BT_SEL 1  &none         &none      &sys_reset                        &studio_unlock  &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                     &kp BACKSPACE
&none   &none         &none         &kp UP_ARROW  &none      &none                             &none           &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS                      &none
&trans  &kp HOME      &kp LEFT      &kp DOWN      &kp RIGHT  &kp END                           &none           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &PAT_Tap_Hold SQT SEMICOLON   &trans
&trans  &none         &none         &none         &none      &none       &bt BT_CLR    &trans  &none           &kp NUMBER_0  &kp NUMBER_0  &kp DOT       &PAT_Tap_Hold ASTERISK SLASH  &kp PIPE
                                    &bootloader   &trans     &trans      &trans        &trans  &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Right_T.Layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Second Layer";
            bindings = <
&kp GRAVE  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6                                            &kp F7                     &kp F8       &kp F9  &kp F10  &kp DEL
&none      &kp F11  &kp F12  &none   &none   &none                   &none                                             &none                      &none        &none   &none    &none
&trans     &none    &none    &none   &none   &none                   &PAT_Tap_Hold RIGHT_PARENTHESIS LEFT_PARENTHESIS  &PAT_Tap_Hold EQUAL MINUS  &none        &none   &none    &none
&trans     &none    &none    &none   &none   &none   &none    &none  &none                                             &none                      &none        &none   &none    &trans
                             &trans  &none   &none   &none    &none  &trans                                            &trans                     &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
